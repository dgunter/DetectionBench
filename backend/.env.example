# Local development only. In production these are systemd credentials read from
# $CREDENTIALS_DIRECTORY (see the unit file); the env vars below are the fallback.
DETECTIONBENCH_ACCESS_TOKEN=CHANGE_ME
DETECTIONBENCH_SESSION_SECRET=CHANGE_ME
DETECTIONBENCH_ANTHROPIC_API_KEY=CHANGE_ME
# Set to 1 when serving over plain http://localhost so the session cookie is accepted.
DETECTIONBENCH_INSECURE_COOKIES=1
